# =============================================================================
# Railway-specific Dockerfile
# Build context is the repo root; source files live in outbound/
# outbound/Dockerfile remains unchanged for Coolify / Docker Compose.
# =============================================================================

FROM python:3.11-slim

# System libraries needed by audio/ML packages
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        libglib2.0-0 \
        libsndfile1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (layer cached unless requirements.txt changes)
COPY outbound/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# Copy application source from outbound/ subdirectory
COPY outbound/ .

# Persistent data directory
RUN mkdir -p /data

ENV DB_PATH=/data/appointments.db

# Railway injects $PORT at runtime; 8000 is the default for local/Coolify
EXPOSE ${PORT:-8000}

CMD ["sh", "start.sh"]
